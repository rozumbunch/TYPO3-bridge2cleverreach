plugin.tx_bridge2cleverreach_subscribeform {
  view {
    templateRootPath = EXT:bridge2cleverreach/Resources/Private/Templates/
    partialRootPath = EXT:bridge2cleverreach/Resources/Private/Partials/
    layoutRootPath = EXT:bridge2cleverreach/Resources/Private/Layouts/
  }

  settings {
    privacyCheckbox {
      # cat=plugin.tx_bridge2cleverreach_subscribeform/a; type=integer; label=Link to Privacy Policy Pid
      linkToPrivacyPolicyPid = 1
    }
  }
}

plugin.tx_bridge2cleverreach_unsubscribeform {
  view {
    templateRootPath = EXT:bridge2cleverreach/Resources/Private/Templates/
    partialRootPath = EXT:bridge2cleverreach/Resources/Private/Partials/
    layoutRootPath = EXT:bridge2cleverreach/Resources/Private/Layouts/
  }
}
