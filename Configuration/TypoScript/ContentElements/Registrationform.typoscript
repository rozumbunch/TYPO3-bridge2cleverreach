tt_content.subscribeform = COA
tt_content.subscribeform {
    10 = USER
    10 {
        userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
        extensionName = Bridge2Cleverreach
        vendorName = Rozumbunch
        pluginName = Subscribeform
        controller = Cleverreach
        
        view < plugin.tx_bridge2cleverreach_subscribeform.view
        settings < plugin.tx_bridge2cleverreach_subscribeform.settings
    }
}


