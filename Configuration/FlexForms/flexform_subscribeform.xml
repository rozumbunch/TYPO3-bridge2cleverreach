<T3DataStructure>
	<sheets>
		<configarea>
			<ROOT>
				<sheetTitle>LLL:EXT:bridge2cleverreach/Resources/Private/Language/locallang_be.xlf:flexform.sheetTitle</sheetTitle>
				<type>array</type>
				<el>
					<settings.newsletterGroups>
						<label>LLL:EXT:bridge2cleverreach/Resources/Private/Language/locallang_be.xlf:flexform.newsletterGroups.label</label>
						<description>LLL:EXT:bridge2cleverreach/Resources/Private/Language/locallang_be.xlf:flexform.newsletterGroups.description</description>
						<displayCond>USER:Rozumbunch\Bridge2Cleverreach\Backend\Form\NewsletterGroupsFieldConfiguration->isVisible</displayCond>
						<config>
							<type>select</type>
							<renderType>selectMultipleSideBySide</renderType>
							<itemsProcFunc>Rozumbunch\Bridge2Cleverreach\Backend\Form\NewsletterGroupsFieldConfiguration->itemsProcFunc</itemsProcFunc>
							<maxitems>20</maxitems>
							<size>5</size>
						</config>
					</settings.newsletterGroups>
					<settings.onlyTechRequirement>
						<label>LLL:EXT:bridge2cleverreach/Resources/Private/Language/locallang_be.xlf:onlyTechRequirement</label>
						<description>LLL:EXT:bridge2cleverreach/Resources/Private/Language/locallang_be.xlf:onlyTechRequirement.description</description>
						<config>
							<type>check</type>
							<renderType>checkboxToggle</renderType>
							<default>0</default>
						</config>
					</settings.onlyTechRequirement>
					<settings.showPrivacyCheckbox>
						<label>LLL:EXT:bridge2cleverreach/Resources/Private/Language/locallang_be.xlf:flexform.showPrivacyCheckbox.label</label>
						<description>LLL:EXT:bridge2cleverreach/Resources/Private/Language/locallang_be.xlf:flexform.showPrivacyCheckbox.description</description>
						<onChange>reload</onChange>
						<config>
							<type>check</type>
							<renderType>checkboxToggle</renderType>
							<default>0</default>
						</config>
					</settings.showPrivacyCheckbox>
					<settings.privacyCheckbox.linkToPrivacyPolicyPid>
						<label>LLL:EXT:bridge2cleverreach/Resources/Private/Language/locallang_be.xlf:flexform.privacyCheckboxLinkToPrivacyPolicyPid.label</label>
						<description>LLL:EXT:bridge2cleverreach/Resources/Private/Language/locallang_be.xlf:flexform.privacyCheckboxLinkToPrivacyPolicyPid.description</description>
						<displayCond>FIELD:settings.showPrivacyCheckbox:=:1</displayCond>
						<config>
							<type>group</type>
							<allowed>pages</allowed>
							<maxitems>1</maxitems>
							<minitems>0</minitems>
							<size>1</size>
							<suggestOptions>
								<default>
									<additionalSearchFields>nav_title, alias, url</additionalSearchFields>
								</default>
							</suggestOptions>
						</config>
					</settings.privacyCheckbox.linkToPrivacyPolicyPid>
				</el>
			</ROOT>
		</configarea>
	</sheets>
</T3DataStructure>
