plugin.tx_bridge2cleverreach_subscribeform {
  view {
    templateRootPaths.0 = EXT:bridge2cleverreach/Resources/Private/Templates/
    templateRootPaths.1 = {$plugin.tx_bridge2cleverreach_subscribeform.view.templateRootPath}
    partialRootPaths.0 = EXT:bridge2cleverreach/Resources/Private/Partials/
    partialRootPaths.1 = {$plugin.tx_bridge2cleverreach_subscribeform.view.partialRootPath}
    layoutRootPaths.0 = EXT:bridge2cleverreach/Resources/Private/Layouts/
    layoutRootPaths.1 = {$plugin.tx_bridge2cleverreach_subscribeform.view.layoutRootPath}
  }
}

plugin.tx_bridge2cleverreach_unsubscribeform {
  view {
    templateRootPaths.0 = EXT:bridge2cleverreach/Resources/Private/Templates/
    templateRootPaths.1 = {$plugin.tx_bridge2cleverreach_unsubscribeform.view.templateRootPath}
    partialRootPaths.0 = EXT:bridge2cleverreach/Resources/Private/Partials/
    partialRootPaths.1 = {$plugin.tx_bridge2cleverreach_unsubscribeform.view.partialRootPath}
    layoutRootPaths.0 = EXT:bridge2cleverreach/Resources/Private/Layouts/
    layoutRootPaths.1 = {$plugin.tx_bridge2cleverreach_unsubscribeform.view.layoutRootPath}
  }
}

##########################
#### CSS ####
##########################

page.includeCSS {
    bridge2cleverreach = EXT:bridge2cleverreach/Resources/Public/Css/newsletter.css
    bridge2cleverreach.media = all
}

##########################
#### CONTENT ELEMENTS ####
##########################
@import 'EXT:bridge2cleverreach/Configuration/TypoScript/ContentElements/'
